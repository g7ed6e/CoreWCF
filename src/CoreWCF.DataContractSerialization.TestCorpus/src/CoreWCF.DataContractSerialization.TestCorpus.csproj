<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
  <PropertyGroup>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <AssemblyName>CoreWCF.DataContractSerialization.TestCorpus</AssemblyName>
    <RootNamespace>CoreWCF.DataContractSerialization.TestCorpus</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Not named *Tests*/*BuildTools*, so IncludeCommonCode would default to true. This corpus is
         deliberately CoreWCF-free: pure BCL, no reflection, so it stays AOT-publishable. -->
    <IncludeCommonCode>false</IncludeCommonCode>
    <!-- Corpus types are copied verbatim from dotnet/runtime and keep upstream shape: unassigned
         public fields, unused privates, obsolete serialization APIs. -->
    <NoWarn>$(NoWarn);CS0169;CS0414;CS0649;CS0618;CS0612;CS8632;SYSLIB0050;SYSLIB0051</NoWarn>
  </PropertyGroup>
</Project>
