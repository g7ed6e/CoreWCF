<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>CoreWCF.DataContractSerialization</AssemblyName>
    <PackageId>CoreWCF.DataContractSerialization</PackageId>
    <RootNamespace>CoreWCF.Runtime.Serialization</RootNamespace>
    <!-- This project has no Resources/Strings.resx, so resources.props sets OmitResources=true and
         no SR.cs is generated. The shared src/Common sources reference SR, so they must not be
         compiled in here. -->
    <IncludeCommonCode>false</IncludeCommonCode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SourceDir)CoreWCF.DataContractSerialization.Generator\src\CoreWCF.DataContractSerialization.Generator.csproj" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ship the source generator inside this package as an analyzer, mirroring how
         CoreWCF.Primitives ships CoreWCF.BuildTools. -->
    <Content Include="$(OutputPath)\CoreWCF.DataContractSerialization.Generator.dll">
      <Pack>true</Pack>
      <PackagePath>analyzers/dotnet/roslyn4.8/cs</PackagePath>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
