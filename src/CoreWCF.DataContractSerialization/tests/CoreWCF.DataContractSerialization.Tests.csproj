<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
  <PropertyGroup>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <RootNamespace>CoreWCF.DataContractSerialization.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Surfaces the build TFM to FixtureStore's per-TFM baseline probe without an #if ladder,
         so new target frameworks need no code change. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TargetFramework</_Parameter1>
      <_Parameter2>$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net472'">
    <PackageReference Include="Microsoft.AspNetCore" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'!='net472'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/CoreWCF.DataContractSerialization.csproj" />
    <ProjectReference Include="$(SourceDir)CoreWCF.DataContractSerialization.TestCorpus\src\CoreWCF.DataContractSerialization.TestCorpus.csproj" />
    <ProjectReference Include="$(SourceDir)CoreWCF.Primitives\src\CoreWCF.Primitives.csproj" />
    <!-- The generator runs on this project rather than on the corpus. Generated code that failed to
         compile would otherwise break the corpus build, taking the reflection oracle down with it -
         and the oracle is what proves the generator wrong. Everything in the first slice has public
         members, so cross-assembly access is not yet a constraint. -->
    <ProjectReference Include="$(SourceDir)CoreWCF.DataContractSerialization.Generator\src\CoreWCF.DataContractSerialization.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Mirrors the gate in CoreWCF.DataContractSerialization.targets, which a package consumer gets
       automatically. That file cannot simply be imported here: NuGet injects it after the SDK
       targets, where TargetFrameworkIdentifier is populated, whereas an import in the project body
       is evaluated before that and would silently see an empty value and disable the generator.
       Conditioned on TargetFramework, which is set this early. -->
  <PropertyGroup Condition="'$(EnableCoreWCFDataContractSerializerGenerator)'=='' AND !$(TargetFramework.StartsWith('net4')) AND !$(TargetFramework.StartsWith('netstandard'))">
    <EnableCoreWCFDataContractSerializerGenerator>true</EnableCoreWCFDataContractSerializerGenerator>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableCoreWCFDataContractSerializerGenerator)'==''">
    <EnableCoreWCFDataContractSerializerGenerator>false</EnableCoreWCFDataContractSerializerGenerator>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="EnableCoreWCFDataContractSerializerGenerator" />
  </ItemGroup>

  <ItemGroup>
    <!-- Inspecting generated code with EmitCompilerGeneratedFiles writes it under the project, where
         the default glob would compile it as ordinary source - so the next build sees every
         generated member declared twice. Exclude it so that inspection stays a read-only act. -->
    <Compile Remove="generated/**" />
    <None Remove="generated/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden fixtures are byte-exact serializer output and must sit next to the test binary:
         CI runs a no-build `dotnet test` against a prebuilt bin/ artifact. -->
    <None Update="Fixtures\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures\net472\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures\net9.0\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures\net10.0\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures\net11.0\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
