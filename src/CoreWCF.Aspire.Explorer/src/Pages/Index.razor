@page "/"
@inject ServiceCatalog Catalog
@inject WsdlExplorerService Explorer
@inject SoapInvoker Invoker

<div class="explorer">
    <FluentSplitter Orientation="Orientation.Horizontal" Panel1Size="340px" Panel1MinSize="240px" BarSize="4">
        <Panel1>
            <div class="tree-pane">
                <FluentLabel Typo="Typography.PaneHeader" Class="pane-title">My Service Projects</FluentLabel>

                @if (Catalog.Services.Count == 0)
                {
                    <FluentLabel Class="muted">
                        No CoreWCF services were configured. Register services with
                        <code>WithCoreWcfService(...)</code> in the Aspire AppHost.
                    </FluentLabel>
                }
                else
                {
                    <FluentTreeView>
                        @foreach (var service in Catalog.Services)
                        {
                            <FluentTreeItem @onclick="() => ToggleServiceAsync(service)" InitiallyExpanded="false">
                                <span class="svc">@service.Name</span>

                                @if (_loading.Contains(service.Name))
                                {
                                    <FluentTreeItem Disabled="true">Loading WSDL&hellip;</FluentTreeItem>
                                }
                                else if (_errors.TryGetValue(service.Name, out var error) && error is not null)
                                {
                                    <FluentTreeItem Disabled="true">@error</FluentTreeItem>
                                }
                                else if (_models.TryGetValue(service.Name, out var model) && model is not null)
                                {
                                    @foreach (var contract in model.Contracts)
                                    {
                                        <FluentTreeItem Text="@contract.Name" InitiallyExpanded="true">
                                            @foreach (var operation in contract.Operations)
                                            {
                                                <FluentTreeItem @onclick="() => SelectOperation(service, operation)"
                                                                class="@(ReferenceEquals(operation, _selectedOperation) ? "op selected" : "op")">
                                                    @operation.Name
                                                </FluentTreeItem>
                                            }
                                        </FluentTreeItem>
                                    }
                                }
                            </FluentTreeItem>
                        }
                    </FluentTreeView>
                }
            </div>
        </Panel1>

        <Panel2>
            <div class="detail-pane">
                @if (_selectedOperation is null)
                {
                    <FluentLabel Class="muted">Select an operation to build a request and invoke it.</FluentLabel>
                }
                else
                {
                    <FluentLabel Typo="Typography.H4">@_selectedOperation.Name</FluentLabel>
                    <div class="meta">
                        <span class="k">Endpoint</span><span class="v"><code>@_selectedService?.EndpointAddress</code></span>
                        <span class="k">SOAP</span><span class="v">@(_selectedOperation.SoapVersion == SoapVersion.Soap12 ? "1.2" : "1.1")</span>
                        <span class="k">Action</span><span class="v"><code>@(_selectedOperation.SoapAction is { Length: > 0 } a ? a : "(none)")</code></span>
                    </div>

                    <FluentCard Class="card">
                        <FluentLabel Typo="Typography.H6">Request</FluentLabel>
                        <FluentTabs @bind-ActiveTabId="_requestTab">
                            <FluentTab Id="req-formatted" Label="Formatted">
                                @if (_selectedOperation.CanUseFormattedRequest)
                                {
                                    @if (_selectedOperation.RequestParameters.Count == 0)
                                    {
                                        <FluentLabel class="muted">This operation takes no parameters.</FluentLabel>
                                    }
                                    else
                                    {
                                        <table class="grid">
                                            <thead><tr><th>Name</th><th>Type</th><th>Value</th></tr></thead>
                                            <tbody>
                                                @foreach (var parameter in _selectedOperation.RequestParameters)
                                                {
                                                    <tr>
                                                        <td>@parameter.Name</td>
                                                        <td class="type">@parameter.TypeName</td>
                                                        <td><FluentTextField @bind-Value="parameter.Value" class="cell-input" /></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                }
                                else
                                {
                                    <FluentLabel class="muted">
                                        This operation has complex parameters. Edit the request in the XML tab.
                                    </FluentLabel>
                                }
                            </FluentTab>
                            <FluentTab Id="req-xml" Label="XML">
                                <FluentTextArea @bind-Value="_requestEnvelope" Rows="16" Class="editor" Spellcheck="false" />
                            </FluentTab>
                        </FluentTabs>
                    </FluentCard>

                    <div class="actions">
                        <FluentButton Appearance="Appearance.Accent" @onclick="InvokeAsync" Loading="_invoking" Disabled="_invoking">
                            Invoke
                        </FluentButton>
                    </div>

                    @if (_invokeError is not null)
                    {
                        <FluentLabel Class="error">@_invokeError</FluentLabel>
                    }
                    else if (_result is not null)
                    {
                        <FluentCard Class="card">
                            <div class="resp-head">
                                <FluentLabel Typo="Typography.H6">Response</FluentLabel>
                                <span class="status @(_result.IsSuccess ? "ok" : "fail")">
                                    @_result.StatusCode @_result.ReasonPhrase &middot; @($"{_result.Elapsed.TotalMilliseconds:F0} ms")
                                </span>
                            </div>
                            <FluentTabs @bind-ActiveTabId="_responseTab">
                                <FluentTab Id="resp-formatted" Label="Formatted">
                                    @if (_parsed is { IsFault: true })
                                    {
                                        <FluentLabel Class="error">Fault: @_parsed.FaultText</FluentLabel>
                                    }
                                    else if (_parsed is { Rows.Count: > 0 })
                                    {
                                        <table class="grid">
                                            <thead><tr><th>Name</th><th>Value</th></tr></thead>
                                            <tbody>
                                                @foreach (var row in _parsed.Rows)
                                                {
                                                    <tr><td>@row.Name</td><td class="val">@row.Value</td></tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    else
                                    {
                                        <FluentLabel class="muted">No structured content; see the XML tab.</FluentLabel>
                                    }
                                </FluentTab>
                                <FluentTab Id="resp-xml" Label="XML">
                                    <pre class="response">@_result.Body</pre>
                                </FluentTab>
                            </FluentTabs>
                        </FluentCard>
                    }
                }
            </div>
        </Panel2>
    </FluentSplitter>
</div>

@code {
    private readonly Dictionary<string, WsdlModel?> _models = new();
    private readonly Dictionary<string, string?> _errors = new();
    private readonly HashSet<string> _loading = new();

    private CoreWcfServiceDescriptor? _selectedService;
    private WsdlOperation? _selectedOperation;

    private string _requestTab = "req-formatted";
    private string _responseTab = "resp-formatted";
    private string _requestEnvelope = string.Empty;

    private bool _invoking;
    private SoapInvocationResult? _result;
    private ParsedSoapResponse? _parsed;
    private string? _invokeError;

    private async Task ToggleServiceAsync(CoreWcfServiceDescriptor service)
    {
        if (_models.ContainsKey(service.Name) || _loading.Contains(service.Name))
        {
            return;
        }

        _loading.Add(service.Name);
        _errors[service.Name] = null;

        try
        {
            _models[service.Name] = await Explorer.LoadAsync(service);
        }
        catch (Exception ex)
        {
            _errors[service.Name] = $"Failed to load WSDL: {ex.Message}";
        }
        finally
        {
            _loading.Remove(service.Name);
        }
    }

    private void SelectOperation(CoreWcfServiceDescriptor service, WsdlOperation operation)
    {
        _selectedService = service;
        _selectedOperation = operation;
        _requestEnvelope = operation.SampleRequestEnvelope;
        _requestTab = operation.CanUseFormattedRequest ? "req-formatted" : "req-xml";
        _result = null;
        _parsed = null;
        _invokeError = null;
    }

    private async Task InvokeAsync()
    {
        if (_selectedService is null || _selectedOperation is null)
        {
            return;
        }

        _invoking = true;
        _result = null;
        _parsed = null;
        _invokeError = null;

        var envelope = _requestTab == "req-formatted" && _selectedOperation.CanUseFormattedRequest
            ? SoapRequestBuilder.BuildEnvelope(_selectedOperation)
            : _requestEnvelope;

        try
        {
            _result = await Invoker.InvokeAsync(_selectedService.EndpointAddress, _selectedOperation, envelope);
            _parsed = SoapResponseParser.Parse(_result.Body);
        }
        catch (Exception ex)
        {
            _invokeError = $"Invocation failed: {ex.Message}";
        }
        finally
        {
            _invoking = false;
        }
    }
}
