<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <IsPackable>false</IsPackable>
    <!-- On every target framework, not only the ones the shipped targets file defaults it on for. The
         emitted code is within what LangVersion 11 allows everywhere, and net472 compiling it is worth
         knowing: a consumer who opts in there should not be the one to discover otherwise. -->
    <EnableCoreWCFConfigurationGenerator>true</EnableCoreWCFConfigurationGenerator>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="EnableCoreWCFConfigurationGenerator" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>

  <!-- The end to end tests drive a real CoreWCF host with a real WCF client. -->
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Primitives" />
    <PackageReference Include="System.ServiceModel.Http" />
    <PackageReference Include="System.ServiceModel.NetTcp" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net472'">
    <PackageReference Include="Microsoft.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Server.Kestrel" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'!='net472'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\CoreWCF.Extensions.Configuration.csproj" />
    <!-- A package consumer gets the generator from analyzers/ inside the package; a project reference does
         not carry that, so it is applied here the way the rest of the repository does it. -->
    <ProjectReference Include="$(SourceDir)CoreWCF.Extensions.Configuration.Generator\src\CoreWCF.Extensions.Configuration.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- The transports these tests exercise. The package itself references CoreWCF.Primitives alone;
         an application brings the transports it uses, and names them by assembly in configuration. -->
    <ProjectReference Include="$(SourceDir)CoreWCF.Http\src\CoreWCF.Http.csproj" />
    <ProjectReference Include="$(SourceDir)CoreWCF.NetTcp\src\CoreWCF.NetTcp.csproj" />
  </ItemGroup>

</Project>
